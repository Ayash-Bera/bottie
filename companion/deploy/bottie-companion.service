[Unit]
Description=Bottie Spotify companion
After=dbus.socket
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bottie/host-runtime
ExecStartPre=-/usr/bin/busctl --user --timeout=5s call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus StartServiceByName su org.kde.secretservicecompat 0
ExecStart=%h/.local/share/bottie/host-runtime/bin/companion
Environment=BOTTIE_BIND=127.0.0.1:8787
Environment=BOTTIE_TOKEN_STORE=keyring
Environment=BOTTIE_MODE=spotify BOTTIE_DEVICE_TOKEN= BOTTIE_ARTWORK_SIZE=96 BOTTIE_POLL_SECONDS=3
UnsetEnvironment=SPOTIFY_CLIENT_ID SPOTIFY_REDIRECT_URI G_DBUS_DEBUG G_MESSAGES_DEBUG
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077
LimitCORE=0
NoNewPrivileges=true

[Install]
WantedBy=default.target
