[Unit]
Description=Bottie authenticated device gateway
Wants=bottie-companion.service
After=bottie-companion.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bottie/host-runtime
EnvironmentFile=%h/.local/share/bottie/host-runtime/gateway.env
ExecStart=%h/.local/share/bottie/host-runtime/bin/device-bridge
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077
LimitCORE=0
NoNewPrivileges=true

[Install]
WantedBy=default.target
