{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Bottie playback v1",
  "type":"object",
  "required":["schema_version","state","track_id","title","artist","album","context","progress_ms","duration_ms","updated_at_ms","shuffle","repeat","artwork","capabilities"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},
    "state":{"enum":["playing","paused","idle","unavailable"]},
    "track_id":{"type":"string","maxLength":128},
    "title":{"$ref":"#/$defs/text"},"artist":{"$ref":"#/$defs/text"},"album":{"$ref":"#/$defs/text"},
    "context":{"type":"object","required":["type","name"],"additionalProperties":false,"properties":{"type":{"enum":["playlist","album","unknown"]},"name":{"$ref":"#/$defs/text"}}},
    "progress_ms":{"type":"integer","minimum":0,"maximum":86400000},
    "duration_ms":{"type":"integer","minimum":0,"maximum":86400000},
    "updated_at_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "shuffle":{"type":"boolean"},"repeat":{"enum":["off","context","track"]},
    "artwork":{"type":"object","required":["url","width","height"],"additionalProperties":false,"properties":{"url":{"type":"string","maxLength":256},"width":{"type":"integer","minimum":0,"maximum":240},"height":{"type":"integer","minimum":0,"maximum":240}}},
    "volume_percent":{"type":["integer","null"],"minimum":0,"maximum":100},
    "control_target":{"type":"string","pattern":"^(|[0-9a-f]{32})$"},
    "control_track":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "offline_reason":{"enum":["login_required","no_active_player","restricted","rate_limited","upstream_unavailable","wallet_locked","wallet_unavailable","stale"]},
    "details":{"type":"object","required":["layout","id"],"additionalProperties":false,"properties":{"layout":{"const":1},"id":{"$ref":"#/$defs/digest"},"title":{"$ref":"#/$defs/detail_field"},"artist":{"$ref":"#/$defs/detail_field"},"album":{"$ref":"#/$defs/detail_field"},"context":{"$ref":"#/$defs/detail_field"}}},
    "clock":{"type":"object","required":["unix_ms","utc_offset_min"],"additionalProperties":false,"properties":{"unix_ms":{"type":"integer","minimum":946684800000,"maximum":4102444799999},"utc_offset_min":{"type":"integer","minimum":-840,"maximum":840}}},
    "text_mask":{"type":"object","required":["url","layout"],"additionalProperties":false,"properties":{"url":{"type":"string","pattern":"^/v1/text/[0-9a-f]{64}$"},"layout":{"const":1}}},
    "capabilities":{"type":"object","required":["play","pause","previous","next","shuffle","repeat"],"additionalProperties":false,"properties":{"play":{"type":"boolean"},"pause":{"type":"boolean"},"previous":{"type":"boolean"},"next":{"type":"boolean"},"shuffle":{"type":"boolean"},"repeat":{"type":"boolean"},"volume":{"type":"boolean"},"seek":{"type":"boolean"}}}
  },
  "$defs":{"text":{"type":"string","maxLength":256},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"detail_field":{"type":"object","required":["pages","flags"],"additionalProperties":false,"properties":{"pages":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/digest"}},"flags":{"type":"integer","minimum":0,"maximum":3}},"if":{"properties":{"pages":{"maxItems":0}}},"then":{"properties":{"flags":{"const":0}}}}}
}
